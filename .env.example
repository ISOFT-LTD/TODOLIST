# Copy to .env and adjust. docker compose reads it automatically.

# Cobalt Core's public keys - set ONE of these two.
#   The URL follows Core's key rotation by itself. Use Core's real hostname so
#   TLS verification passes; CORE_HOSTNAME below makes it resolve to this machine.
COBALT_CORE_JWKS_URL=https://staging.pulsar.ao:3008/auth/.well-known/jwks.json
#   Or a saved copy (curl -sk https://127.0.0.1:3008/auth/.well-known/jwks.json
#   -o cobalt/core-jwks.json). Does not follow a key rotation: fetch it again.
# COBALT_CORE_JWKS_FILE=/run/cobalt/core-jwks.json

# Core's hostname, mapped to this machine inside the backend container.
CORE_HOSTNAME=staging.pulsar.ao

# Must match Core's CORE_JWT_ISSUER and CORE_TENANT_ID.
COBALT_ISSUER=cobalt-core
COBALT_TENANT_ID=itec-prod

# Where Core reaches this app: COBALT_APP_URL_TODO=http://127.0.0.1:8080 on Core.
TODO_BIND_ADDRESS=127.0.0.1
TODO_PORT=8080
