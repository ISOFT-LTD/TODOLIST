{
  "manifestVersion": 2,
  "id": "todo",
  "name": "Todo List",
  "version": "1.1.0",
  "description": "A personal todo list, served behind Cobalt Core's /apps proxy",
  "icon": "fa-square-check",

  "compatibility": {
    "mountApiVersion": 1,
    "coreIdentity": 1,
    "coreMin": "1.0.0"
  },

  "core": {
    "tabKeys": ["todo"],
    "roleNames": [],
    "tokenTtlSeconds": 180
  },

  "routes": {
    "frontend": "/apps/todo/",
    "backend": "/apps/todo/api"
  },

  "navigation": [
    {
      "label": "Todo List",
      "path": "/apps/todo/",
      "icon": "fa-square-check",
      "order": 100,
      "permission": "todo:read"
    }
  ],

  "frontend": {
    "type": "module-federation",
    "bundler": "vite",
    "remoteName": "todo_plugin",
    "remoteEntry": "remoteEntry.js",
    "mfManifest": "mf-manifest.json",
    "exposedModule": "./TodoApp",
    "mountFunction": "mount",
    "unmountFunction": "unmount",
    "sdk": ["api"],
    "shared": []
  },

  "backend": {
    "apiRoot": "/api",
    "healthCheck": "/api/health",
    "manifest": "/api/manifest",
    "openapi": "/api/openapi.json"
  },

  "permissions": [
    { "key": "todo:read", "description": "View todo items", "tab": "todo", "level": "read" },
    { "key": "todo:write", "description": "Create, edit and delete todo items", "tab": "todo", "level": "all" }
  ]
}
