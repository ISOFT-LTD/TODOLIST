{
  "manifestVersion": 2,
  "id": "todo",
  "name": "Todo List",
  "version": "1.5.0",
  "description": "A personal todo list with reusable predefined lists, served behind Cobalt Core's /apps proxy",
  "icon": "fa-square-check",
  "compatibility": {
    "mountApiVersion": 1,
    "hostApiVersion": 1,
    "sdkApiVersion": 1
  },
  "core": {
    "tabKeys": [
      "todo"
    ],
    "roleNames": [],
    "tokenTtlSeconds": 180,
    "tabLabels": {
      "todo": "Todo List"
    }
  },
  "routes": {
    "frontend": "/apps/todo/",
    "backend": "/apps/todo/api"
  },
  "navigation": [
    {
      "label": "todo",
      "icon": "fa-square-check",
      "order": 100,
      "path": "/plugins/ui/todo",
      "children": [
        {
          "label": "todo-list",
          "path": "/plugins/ui/todo",
          "permission": "todo:read",
          "subTab": "list",
          "order": 101
        },
        {
          "label": "todo-predefined",
          "path": "/plugins/ui/todo/predefined",
          "permission": "todo:read",
          "subTab": "predefined",
          "order": 102
        }
      ]
    }
  ],
  "frontend": {
    "type": "module-federation",
    "bundler": "vite",
    "remoteName": "todo_plugin",
    "remoteEntry": "remoteEntry.js",
    "mfManifest": "mf-manifest.json",
    "exposedModule": "./TodoApp",
    "mountFunction": "mount",
    "unmountFunction": "unmount",
    "sdk": [
      "api",
      "i18n"
    ],
    "shared": []
  },
  "permissions": [
    {
      "key": "todo:read",
      "description": "View todo items and predefined lists",
      "tab": "todo",
      "level": "read"
    },
    {
      "key": "todo:write",
      "description": "Create, edit and delete todo items and predefined lists",
      "tab": "todo",
      "level": "all"
    }
  ],
  "contributes": [
    {
      "id": "computer-todo-action",
      "target": "computer.details.header.actions",
      "exposedModule": "./ComputerTodoAction",
      "order": 100
    },
    {
      "id": "computer-todo-tab",
      "target": "computer.details.tabs",
      "label": "todo",
      "icon": "fa-square-check",
      "exposedModule": "./ComputerTodoTab",
      "order": 100
    },
    {
      "id": "todo-user-settings",
      "target": "settings.navigation.user",
      "label": "todo",
      "icon": "fa-square-check",
      "exposedModule": "./TodoUserSettings",
      "order": 100
    },
    {
      "id": "todo-system-settings",
      "target": "settings.navigation.system",
      "label": "todo",
      "icon": "fa-square-check",
      "exposedModule": "./TodoSystemSettings",
      "order": 100
    }
  ],

  "actions": [
    {
      "key": "todo.view",
      "name": "View Todo Items",
      "description": "View personal todo items",
      "module": "items"
    },
    {
      "key": "todo.create",
      "name": "Create Todo Item",
      "description": "Create a new todo item",
      "module": "items"
    },
    {
      "key": "todo.update",
      "name": "Update Todo Item",
      "description": "Edit an existing todo item",
      "module": "items"
    },
    {
      "key": "todo.delete",
      "name": "Delete Todo Item",
      "description": "Delete an existing todo item",
      "module": "items"
    },
    {
      "key": "predefined.view",
      "name": "View Predefined Todo Lists",
      "description": "View reusable predefined todo lists",
      "module": "predefined"
    },
    {
      "key": "predefined.create",
      "name": "Create Predefined Todo List",
      "description": "Create a reusable predefined todo list",
      "module": "predefined"
    },
    {
      "key": "predefined.update",
      "name": "Update Predefined Todo List",
      "description": "Edit a predefined todo list",
      "module": "predefined"
    },
    {
      "key": "predefined.delete",
      "name": "Delete Predefined Todo List",
      "description": "Delete a predefined todo list",
      "module": "predefined"
    }
  ],

  "backend": {
    "apiRoot": "/api",
    "healthCheck": "/api/health",
    "manifest": "/api/manifest",
    "openapi": "/api/openapi.json"
  }
}
