{
  "manifestVersion": 1,
  "id": "todo",
  "name": "Todo List",
  "version": "1.0.0",
  "description": "Todo List plugin POC",
  "icon": "check-square",

  "compatibility": {
    "mountApiVersion": 1,
    "coreMin": "1.0.0"
  },

  "routes": {
    "frontend": "/plugins/ui/todo",
    "backend": "/api/plugins/todo"
  },

  "navigation": [
    {
      "label": "Todo List",
      "path": "/plugins/ui/todo",
      "icon": "fa-square-check",
      "order": 100,
      "permission": "todo:read"
    }
  ],

  "frontend": {
    "type": "module-federation",
    "bundler": "vite",
    "remoteName": "todo_plugin",
    "remoteEntry": "remoteEntry.js",
    "mfManifest": "mf-manifest.json",
    "exposedModule": "./TodoApp",
    "mountFunction": "mount",
    "unmountFunction": "unmount",
    "sdk": ["api"],
    "shared": []
  },

  "backend": {
    "apiRoot": "/api",
    "healthCheck": "/api/health",
    "manifest": "/api/manifest",
    "openapi": "/api/openapi.json"
  },

  "permissions": [
    { "key": "todo:read", "description": "View todo items" },
    { "key": "todo:write", "description": "Create, edit and delete todo items" }
  ]
}

