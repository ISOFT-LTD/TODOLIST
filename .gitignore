# --- Dependencies ---------------------------------------------------------
node_modules/

# --- Frontend build output ------------------------------------------------
frontend/dist/
.vite/
.__mf__temp/
@mf-types/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# --- Local environment files (examples stay committed) --------------------
.env
.env.*
!.env.example

# --- Runtime Todo data ----------------------------------------------------
# Local runs write backend/todos.json and backend/predefined_lists.json. Docker keeps its copy on the todo-data
# volume; /data/ covers switching that to a bind mount.
backend/todos.json
backend/predefined_lists.json
/data/
*.tmp

# --- Logs -----------------------------------------------------------------
*.log
npm-debug.log*

# --- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Local stand-in for Core -------------------------------------------
# dev/fake_core.py writes a throwaway public key here on every start.
dev/.dev-jwks.json

# --- Core's public keys, saved per deployment (see cobalt/README.md) ------
cobalt/*.json
